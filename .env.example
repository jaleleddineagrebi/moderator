# Copy to .env and fill in GEMINI_API_KEY (from https://aistudio.google.com/apikey).
GEMINI_API_KEY=

# Optional free stock media APIs (used as fallback or when -p visual_mode=stock):
# https://www.pexels.com/api/
PEXELS_API_KEY=
# https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Optional read-only trend research (Google Cloud Console > YouTube Data API v3 > API key):
YOUTUBE_API_KEY=
